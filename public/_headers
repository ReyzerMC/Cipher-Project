/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  # CSP en modo "solo informar": no bloquea nada, pero la consola del navegador
  # avisa de lo que bloquearía. Cuando no veas avisos en toda la web, cambia
  # el nombre a Content-Security-Policy para activarla.
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://cdn.cipher-project.reyzer.org; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
